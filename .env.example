# Local development configuration
MONGODB_URI=mongodb://localhost:27017/azharuddin_next
# Used to sign the admin session cookie. Change this in production (min 32 chars).
SESSION_SECRET=dev-only-session-secret-change-me-in-production-32chars
# Public site URL, used for canonical/Open Graph URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Credentials created by `npm run seed` for the first admin login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
